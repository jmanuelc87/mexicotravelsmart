# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=https://mexicotravelsmart.vercel.app/

# Site
NEXT_PUBLIC_SITE_URL=https://mexicotravelsmart.mx
NEXT_PUBLIC_BASE_URL=https://mexicotravelsmart.mx

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Session (iron-session) — must be at least 32 characters
SESSION_SECRET=replace_with_a_random_32plus_char_secret_key

# Bot API
BOT_API_URL=http://localhost:8000
BOT_API_KEY=aa
